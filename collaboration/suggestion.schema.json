{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lectern suggestion, version 1",
  "description": "User-authored contribution draft. No automatic device, account or study-store data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "title", "resource", "reference", "language", "details", "sourceURL"],
  "properties": {
    "schemaVersion": {"const": 1, "type": "integer"},
    "kind": {"enum": ["text-correction", "resource-suggestion", "translation", "usability"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"},
    "resource": {"type": "string", "maxLength": 1000},
    "reference": {"type": "string", "maxLength": 1000},
    "language": {"type": "string", "maxLength": 1000},
    "details": {"type": "string", "minLength": 1, "maxLength": 20000, "pattern": "\\S"},
    "sourceURL": {"type": "string", "maxLength": 1000, "pattern": "^(|https://[^\\s]+)$", "description": "Empty, or HTTPS URL with host and no embedded credentials; enforce semantic checks with the companion validator."}
  }
}
